{
  "description": "ssn-guard: mask Social Security numbers before they reach the model",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ssn_guard_root=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; if [ -r \"$ssn_guard_root/scripts/launch_posix.sh\" ]; then . \"$ssn_guard_root/scripts/launch_posix.sh\"; else echo 'ssn-guard: launcher unavailable; blocked for safety' >&2; exit 2; fi",
            "timeout": 30,
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "ssn_guard_root=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; if [ -r \"$ssn_guard_root/scripts/launch_posix.sh\" ]; then . \"$ssn_guard_root/scripts/launch_posix.sh\"; else echo 'ssn-guard: launcher unavailable; blocked for safety' >&2; exit 2; fi",
            "timeout": 90,
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ssn_guard_root=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; if [ -r \"$ssn_guard_root/scripts/launch_posix.sh\" ]; then . \"$ssn_guard_root/scripts/launch_posix.sh\"; else echo 'ssn-guard: launcher unavailable; blocked for safety' >&2; exit 2; fi",
            "timeout": 60,
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
